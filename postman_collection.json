            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"someoneelse{{$timestamp}}\",\n  \"email\": \"{{user1Email}}\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
