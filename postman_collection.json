  "item": [
    {
      "name": "1. Signup and Login",
      "item": [
        {
          "name": "1.1 Signup (user 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{user1Name}}\",\n  \"email\": \"{{user1Email}}\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Date.now();",
                  "pm.collectionVariables.set(\"user1Name\", \"victor\" + n);",
                  "pm.collectionVariables.set(\"user1Email\", \"victor\" + n + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"User registered, no password returned\", () => { pm.expect(j.message).to.eql(\"User registered\"); pm.expect(j).to.have.keys([\"message\",\"id\",\"username\",\"email\"]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Signup again with same email (duplicate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
